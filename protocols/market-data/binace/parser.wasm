#include <emscripten.h>
#include <msgpack.hpp>

EMSCRIPTEN_KEEPALIVE
extern "C" uint8_t* parse_market_data(uint8_t* input, size_t len) {
  try {
    msgpack::object_handle oh = msgpack::unpack((const char*)input, len);
    msgpack::object obj = oh.get();
    
    MarketData data;
    obj.convert(data);
    
    auto processed = process_data(data);
    msgpack::sbuffer sbuf;
    msgpack::pack(sbuf, processed);
    
    uint8_t* result = (uint8_t*)malloc(sbuf.size());
    memcpy(result, sbuf.data(), sbuf.size());
    return result;
    
  } catch (...) {
    return nullptr;
  }
}